{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hokmnameh.invalid/schemas/change-request-v1.json",
  "title": "Hokmnameh Change Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "decision_id", "title", "status", "category", "requester", "created_at", "source_refs", "affected_paths", "requirement_ids", "impact", "risk_flags", "approvals", "acceptance_criteria", "test_plan", "rollback_plan", "emergency"],
  "properties": {
    "id": {"type": "string", "pattern": "^CR-[0-9]{4}-[0-9]{4}$"},
    "decision_id": {"type": "string", "pattern": "^DEC-[0-9]{4}-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 8},
    "status": {"enum": ["DRAFT", "TRIAGE", "IMPACT_ASSESSED", "APPROVED", "IMPLEMENTING", "VERIFIED", "RELEASED", "REJECTED", "SUPERSEDED"]},
    "category": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["rules", "economy", "api", "database", "ux"]}},
    "requester": {"type": "string", "minLength": 2},
    "created_at": {"type": "string", "format": "date-time"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "affected_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
    "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(FR|NFR|SEC|DATA|OPS)-[0-9]{3}$"}},
    "impact": {"type": "object", "additionalProperties": false, "required": ["player", "compatibility", "data", "operations"], "properties": {"player": {"type": "string"}, "compatibility": {"type": "string"}, "data": {"type": "string"}, "operations": {"type": "string"}}},
    "risk_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["role", "decision", "at", "evidence"], "properties": {"role": {"type": "string"}, "decision": {"enum": ["APPROVE", "REJECT"]}, "at": {"type": "string", "format": "date-time"}, "evidence": {"type": "string", "minLength": 3}}}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "test_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "rollback_plan": {"type": "string", "minLength": 8},
    "migration_plan": {"type": ["string", "null"]},
    "security_review": {"type": ["string", "null"]},
    "emergency": {"type": "object", "additionalProperties": false, "required": ["enabled", "reason", "post_review_due_at"], "properties": {"enabled": {"type": "boolean"}, "reason": {"type": ["string", "null"]}, "post_review_due_at": {"type": ["string", "null"], "format": "date-time"}}},
    "supersedes": {"type": ["string", "null"]}
  }
}
